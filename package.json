{
  "name": "zaidan-profile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @zaidan/main",
    "dev:lab": "npm run dev -w @zaidan/lab",
    "build": "npm run build -w @zaidan/main && npm run build -w @zaidan/lab",
    "build:main": "npm run build -w @zaidan/main",
    "build:lab": "npm run build -w @zaidan/lab"
  }
}
