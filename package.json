{
  "name": "zaidan-profile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @zaidan/main",
    "dev:3d": "npm run dev -w @zaidan/lab-3d",
    "build": "npm run build -w @zaidan/main && npm run build -w @zaidan/lab-3d",
    "build:main": "npm run build -w @zaidan/main",
    "build:3d": "npm run build -w @zaidan/lab-3d",
    "test:parity": "npm run build:3d && node scripts/parity-check.mjs"
  }
}
